{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Long Horizon Cortex",
  "version": "0.0.1",
  "identifier": "com.cortex-mechanism.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../../web run dev -- --port 3737",
    "beforeBuildCommand": "npm --prefix ../../web run build",
    "devUrl": "http://localhost:3737",
    "frontendDist": "../../web/out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Long Horizon Cortex",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 720,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:* ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Personal cortex desktop shell"
  }
}
