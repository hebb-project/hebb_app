# Copy to `.env` for local development: `cp .env.example .env`
#
# The Rust core (core/) loads this via dotenvy. `task dev` runs the core on
# the host (not in Docker), so it reads these values from your shell / .env.
#
# DATABASE_URL is the only required value — the core exits with
# "missing value for field database_url" if it is unset. Everything else has
# a sensible default (see core/src/config.rs).

# Postgres runs via `docker compose up -d postgres`, mapped to host port 5433
# (5432 inside the docker network). Credentials come from docker-compose.yml.
DATABASE_URL=postgres://cortex:cortex@localhost:5433/cortex_dev

# Optional overrides (defaults shown):
# WS_HOST=127.0.0.1
# WS_PORT=7654
# VAULT_PATH=./tests/mock-knowledge-base
